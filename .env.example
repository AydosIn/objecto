# Copy to .env and fill in. Never commit .env.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. Leave unset to use the local SQLite file.
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/object_biographies

# From https://aistudio.google.com/apikey (needed from Phase 5)
GEMINI_API_KEY=
# The latest stable Gemini Flash model name
GEMINI_MODEL=gemini-3.8-flash

# Optional: USD per 1M tokens for the admin analytics cost estimate
# GEMINI_PRICE_INPUT_PER_M=0.75
# GEMINI_PRICE_OUTPUT_PER_M=3.75

# Cloudflare R2 for uploaded photos. Leave unset to keep photos in media/ locally.
# From R2 > Overview > Manage API tokens > Create Account API token (Object Read & Write).
# R2_ACCOUNT_ID is the part of "Endpoint for S3 clients" before .r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=objecto-media
