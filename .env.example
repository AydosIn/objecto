# Copy to .env and fill in. Never commit .env.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# From https://aistudio.google.com/apikey (needed from Phase 5)
GEMINI_API_KEY=
# The latest stable Gemini Flash model name
GEMINI_MODEL=
